# Скопируй в .env и заполни значения. .env в git не коммитится.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# URL мини-приложения (домен туннеля / деплоя)
MINI_APP_URL=https://example.lhr.life
# Ссылка на правила сервиса
RULES_URL=https://example.netlify.app

# Путь к файлу SQLite
DB_PATH=orders.db
# Разрешённые CORS origin через запятую, * — любой
CORS_ORIGINS=*

# LM Studio (модерация объявлений)
LM_BASE_URL=http://localhost:1234/v1
LM_MODEL=google/gemma-3-1b
LM_API_KEY=lm-studio
# Пауза между проходами очереди модерации, секунд
MODERATION_POLL_INTERVAL=3
